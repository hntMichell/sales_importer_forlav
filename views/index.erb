<!DOCTYPE html>
<html>
<head>
  <title>Sales Importer</title>
  <style>
    body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto;
      background: #f5f7fa;
      margin: 0;
      height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .container {
      background: white;
      padding: 40px;
      border-radius: 12px;
      box-shadow: 0 10px 25px rgba(0,0,0,0.08);
      width: 400px;
      text-align: center;
    }

    h1 {
      margin-bottom: 10px;
      color: #333;
    }

    p {
      color: #777;
      font-size: 14px;
      margin-bottom: 30px;
    }

    input[type="file"] {
      margin-bottom: 20px;
    }

    button {
      background: #4f46e5;
      color: white;
      border: none;
      padding: 12px 20px;
      border-radius: 8px;
      cursor: pointer;
      font-weight: bold;
      transition: 0.2s;
    }

    button:hover {
      background: #4338ca;
    }

    .result {
      margin-top: 25px;
      padding: 15px;
      background: #ecfdf5;
      border: 1px solid #10b981;
      border-radius: 8px;
      color: #065f46;
      font-weight: bold;
    }
  </style>
</head>

<body>

  <div class="container">
    <h1>Sales Importer</h1>
    <p>Upload your .tab file to process sales data</p>

    <form action="/upload" method="post" enctype="multipart/form-data">
      <input type="file" name="file" required>
      <br>
      <button type="submit">Upload File</button>
    </form>

    <% if @total %>
      <div class="result">
        Total Gross Income: $<%= @total %>
      </div>
    <% end %>
  </div>

</body>
</html>