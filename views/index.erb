<!DOCTYPE html>
<html>
<head>
  <title>Upload Sales</title>
</head>
<body>

<h1>Upload Sales File</h1>

<form action="/upload" method="post" enctype="multipart/form-data">
  <input type="file" name="file">
  <button type="submit">Upload</button>
</form>

<% if @total %>
  <h2>Total Gross Income: $<%= @total %></h2>
<% end %>

</body>
</html>